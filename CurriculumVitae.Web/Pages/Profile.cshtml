@page "{Id:int}"
@using CurriculumVitaeRepository.Entities;
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model CurriculumVitae.Web.Pages.ProfileModel

@{
    

}
@if (SignInManager.IsSignedIn(User))
{
    <input id="editable" value="false" type="hidden" asp-for="IsEditing"  />
     <button id="edit" type="button" onclick="enableEdit()" class="btn btn-outline-primary display" >Edit</button>
}


<h3>Profiel @Model.Id </h3>
<section>
    <fieldset>
        <div class="display">        
            <p>@Model.Profiel?.Beschrijving</p>
            <p><label>Actief</label><span>@Model.Profiel?.Enabled</span></p>    
        </div>
        <div class="edit" hidden> 
            <label for="profiel" asp-for="Profiel">Profiel tekst</label>   
            <input type="number" id="profileId" name="profileId" asp-for="Profiel.Id" hidden/>
            <textarea id="profiel" name"profiel" asp-for="Profiel.Beschrijving"></textarea>   
            <input type="checkbox" id="profileEnabled" name="profileEnabled" asp-for="Profiel.Enabled" />
            <span asp-validation-for="Profiel" class="danger"></span>                
        </div>
    </fieldset>
</section>
<h3>Talen</h3>
<section>    
    <fieldset>
        <div class="display">
            @foreach(Taal taal in @Model.Talen?.Where(d => d!= null && d.profiel!= null && d.profiel.Id == Model.Profiel?.Id)??new List<Taal>())
            {
                <ul class="list-group list-group-horizontal d-flex">
                    <li class="col-1">@taal.TaalOmschrijving</li>
                    <li class="col-1">@taal.Niveau</li>                    
                </ul>                                
            }            
        </div>
        <div class="edit">            
                <div id="languages">
                    @foreach (Taal taal in @Model.Talen??new List<Taal>())
                    {
                        <ul class="list-group list-group-horizontal d-flex gap-5">
                            <li class="form-field col-1">@taal.Id</li>
                            <li class="form-field col-6">@taal.TaalOmschrijving</li>
                            <li class="form-field col-6">@taal.Niveau</li>
                        </ul>
                    }
                </div>
                <input type="text" list="options" id="newLanguage" onchange="addLanguage()" />
                <!--select id="selectLanguage" asp-for="SelectLanguage" onchange="onLanguageSelectionChange(this)"-->
                <datalist id="options">
                    <option value="" >--Select a language--</option>
                    @if(@Model.TaalLijst!=null){
                        @foreach (var taal in @Model.TaalLijst)
                        {
                            <option value=@taal>
                                <ul class="list-group list-group-horizonatal d-flex">
                                    <li>@taal</li>
                                </ul>
                            </option>
                        }
                    }                    
                </datalist>
                <div id="selectLanguageRegion" hidden>
                    <select id="selectLanguageLevel" hidden>
                        <option value="Basis">
                            Basis
                        </option>
                        <option value="Goed">Goed</option>
                        <option value="Zeer goed">Zeer goed</option>
                        <option value="Moedertaal"></option>
                    </select>
                    <button type="button" onclick="languageAdd()">Toevoegen</button>
                </div>
               </div>
    </fieldset>
</section>
<h3>Persooonlijke vaardigheden</h3>
<section>
    <fieldset>
        <div class="display">
            @foreach (Persoonlijkevaardigheid e in @Model.Persoonlijkevaardigheden?
                .Where(d => d != null && d.Profiel != null && d.Profiel.Id == Model.Profiel?.Id)?? new List<Persoonlijkevaardigheid>())
            {
                <ul>
                    <li>@e.Name</li>                    
                </ul>
            }

        </div>
        <div class="edit">
            <div id="personalskills">
                @foreach(Persoonlijkevaardigheid e in Model.Persoonlijkevaardigheden?
                    .Where(d => d != null && d.Profiel != null && d.Profiel.Id == Model.Profiel?.Id) ?? new List<Persoonlijkevaardigheid>())
                {
                    <ul>
                        <li>@e.Name</li>
                    </ul>
                }                
            </div>
            <input id="newpersonalskill" type="text" onchange="onNewPersonalSkill(this)" /> 
        </div>
    </fieldset>
</section>
<h3>Computer vaardigheden</h3>
<section>
    <fieldset>
        <div class="display">
            @foreach (Computervaardigheid e in @Model.Computervaardigheden?
                .Where(d => d != null && d.Profiel != null && d.Profiel.Id == Model.Profiel?.Id)??new List<Computervaardigheid>())
            {
                <ul>
                    <li>@e.Omschrijving</li>
                </ul>
            }
        </div>
        <div class="edit">
            <div id="computerskills">
                @foreach (Computervaardigheid e in @Model.Computervaardigheden?
                .Where(d => d != null && d.Profiel != null && d.Profiel.Id == Model.Profiel?.Id) ?? new List<Computervaardigheid>())
                {
                    <ul>
                        <li>@e.Omschrijving</li>
                    </ul>
                }                
            </div>
            <input id="newcomputerskill" type="text" onchange="onNewComputerSkill(this)" />
        </div>
    </fieldset>
</section>
<h3>Werkervaring</h3>
<section>
    <fieldset>
        <div class="display">            
                @foreach (WerkErvaring e in @Model.Werkervaringen ?? new  List<WerkErvaring>())
                {
                    <ul>
                        <li>@e.Bedrijf</li>
                    </ul>
                }                        
        </div>
        <div class="edit">
            <div id="workexperiences">
                @foreach (WerkErvaring e in @Model.Werkervaringen ?? new List<WerkErvaring>())
                {
                    <ul>
                        <li>@e.Bedrijf</li>
                    </ul>
                }
            </div>
        </div>
    </fieldset>
</section>
<button type="button" class="btn btn-outline-primary edit" onclick="Save()" >Opslaan</button>
<form method="post">
<button type="submit" class="btn btn-outline-primary edit" asp-page-handler="Cancel">Annuleren</button> 
</form>
<div id="validationErrors" class="alert alert-danger d-none">
    <ul id="validationErrorList"></ul>
    
</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script >                
        // Buffers for data
        let talen = [];
        let personalskills = [];
        let computerskills = [];
        let workexperiences= [];
        // delete buffers
        let talenDel = [];
        let personalskillsDel = [];
        let computerskillsDel = [];
        let workexperiencesDel= [];
        /// 
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".display").forEach(element => {element.hidden = false;});
            document.querySelectorAll(".edit").forEach(element => {element.hidden = true;});
            talen = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Talen));
            personalskills = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Persoonlijkevaardigheden));
            computerskills = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Computervaardigheden));
            workexperiences = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Werkervaringen));
            listLanguages(talen);
            listPersonalSkills(personalskills);
            listComputerSkills(computerskills);
        });
        
        
        const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;
        const enableEdit = async () => {            
            const result = await fetch("?handler=Edit", {
                method: "POST",
                headers: {
                    "RequestVerificationToken": token
                }

            });            
            document.getElementById("editable").value= "true";
            switchEditMode(true);
        };
        const Save = async () => {
            console.log("test");
            const profielId = document.getElementById("profileId").value;
            const profielEnabled = document.getElementById("profileEnabled").checked ?? false;
            const profiel = document.getElementById("profiel").value;
            if(profiel){
                console.log("Profiel ingevuld");
            }
            const ttalen = JSON.stringify(talen);
            const payLoad = {                
                Profiel: { 
                    Id: profielId,
                    Beschrijving: profiel,
                    Enabled: profielEnabled
                },
                Talen: talen,
                Persoonlijkevaardigheden: personalskills,
                Workexperiences: workexperiences,
                TalenDel: talenDel,
                PersonalSkillsDel: personalskillsDel,
                ComputerSkillsDel: computerskillsDel,
                WorkexperiencesDel: workexperiencesDel
            };
            console.log(payLoad);

            const result = await fetch("?handler=Save", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token,                    
                },
                body: JSON.stringify(payLoad)
            });               
            console.log("HTTP status:", result.status);
            console.log("Response:", await result.text());
        };
        const Cancel = async () => {            
            const result = await fetch("?handler=Cancel", {
                method: "POST",
                headers: {
                    "RequestVerificationToken": token
                }
            });                        
        };
        const switchEditMode = async (editMode) => {
            listLanguages(talen);
            document.querySelectorAll(".display").forEach(element => {element.hidden = editMode;});
            document.querySelectorAll(".edit").forEach(element => {element.hidden = !editMode;});
        };
        const onLanguageSelectionChange = (e) => {
            const clanguages = document.getElementById("selectLanguage");
            const clanguageSelection = document.getElementById("selectLanguageLevel");
            if(clanguages.value == ""){
                clanguageSelection.hidden=true;
                document.getElementById("selectLanguageRegion").hidden=true;
            } else{
                clanguageSelection.hidden=false;
                document.getElementById("selectLanguageRegion").hidden=false;
            }
        }
        const languageAdd = (e) => {            
            const clanguage = document.getElementById("selectLanguage");
            const clanguageSelection = document.getElementById("selectLanguageLevel");
            talen.push( {  
                Id: 0,
                Profiel: null,
                TaalOmschrijving: clanguage.value,
                Niveau: clanguageSelection.value,
                
            });            
            listLanguages(talen);
        }
        const listLanguages = (elementen) => {
            console.log("Build languages");                        
            const list = document.getElementById("languages");
            if(list){

                let tempHtmlList = "<ul>";
                if(elementen){
                    elementen.forEach(taal => {
                        tempHtmlList += `<li id="${taal.Id}">` 
                        tempHtmlList += `<div class="list-group list-group-horizontal d-flex gap-5">`
                        tempHtmlList += `<span class="form-field col-6">${taal.TaalOmschrijving}</span>`;
                        tempHtmlList += `<span class="form-field col-6">`
                        tempHtmlList += `<input type="text" name="level" index="${taal.Id}" language="${taal.TaalOmschrijving}" value="${taal.Niveau}" onchange="onLanguageChange(this)"/>`;
                        tempHtmlList += `<span class="form-field col-2" index="${taal.Id}" language="${taal.TaalOmschrijving}" onclick="onLanguageDelete(this)"><img src="/Images/delete.png" class="form-field col-1" alt="Delete image" />`
                        tempHtmlList += `</span>`
                        tempHtmlList += "</div>"
                        tempHtmlList += "</li>"
                    });
                    tempHtmlList += "</ul>";
                    list.innerHTML = tempHtmlList;
                    /*var inputLanguages = document.querySelectorAll(`level`);
                    inputLanguages.forEach(e => {
                        console.log(e);
                    });*/
                }                
            }            
        }
        const addLanguage = () => {
            const list = document.getElementById("newLanguage");
            if(list){
                /// TODO: Moet in de vorm van taal of vereenvoudige DTO (ik nu nu eerder vereenvoudigde omdat ook profiel er nog inzit)
                //talen.push(list.value);
                talen.push( {
                    Id: 0,
                        Profiel: null,
                            TaalOmschrijving: list.value,
                            Niveau: "Beginner",
                    });
                listLanguages(talen);
            }
        }
        const onLanguageChange = (e) => {
            if(e){
                const id = e.getAttribute("index");
                const language = e.getAttribute("language");
                const value = e.value;
                talen.forEach( l => {
                    if (l.Id == id || l.TaalOmschrijving == language){
                        console.log("gevonden");
                        l.Niveau = value;
                    }else{
                        console.log("Niet gevonden");
                    }
                });
            }                        
        }
        const onLanguageDelete = (e) => {
            if(e){
                console.log(e);
                const id = e.getAttribute("index");
                const language = e.getAttribute("language");
                talen.forEach( l => {
                    if(l.Id == id || l.TaalOmschrijving == language){
                        talen = talen.filter( t => t.TaalOmschrijving != language);
                        talenDel.push(id);
                        listLanguages(talen);
                    }
                });
            }
        }
        const listPersonalSkills = (elementen) => {            
            const list = document.getElementById("personalskills");
            if (list) {
                let tempHtmlList = "<ul>";
                if (elementen) {
                    elementen.forEach(skill => {
                        tempHtmlList += `<li id="${skill.Id}">`
                        tempHtmlList += `<div class="list-group list-group-horizontal d-flex gap-5">`
                        tempHtmlList += `<span class="form-field col-6">${skill.Name}</span>`;
                        tempHtmlList += `<span class="form-field col-6">`
                        
                        tempHtmlList += `</span>`
                        tempHtmlList += `<span class="form-field col-2" index="${skill.Id}" name2="${skill.Name}" onclick="onPersonalSkillDelete(this)"><img src="/Images/delete.png" class="form-field col-1" alt="Delete image" />`
                        tempHtmlList += "</div>"
                        tempHtmlList += "</li>"
                    });
                    tempHtmlList += "</ul>";
                    list.innerHTML = tempHtmlList;                    
                }
            }
        }
        const onNewPersonalSkill = (e) => {
            if(e){
                const list = document.getElementById("newpersonalskill");
                if(list){
                /// TODO: Moet in de vorm van taal of vereenvoudige DTO (ik nu nu eerder vereenvoudigde omdat ook profiel er nog inzit)
                //talen.push(list.value);
                   personalskills.push( {
                        Id: 0,
                        Profiel: null,
                        Name: list.value,
                        Enabled: true
                    });
                    listPersonalSkills(personalskills);
                }
            }
        }
        const onPersonalSkillDelete = (e) => {                
                const id = e.getAttribute("index");
                const name = e.getAttribute("name2");
                personalskills.forEach( l => {
                    if(l.Id == id || l.Name == name){
                        personalskills = personalskills.filter( t => t.Name != name);
                        listPersonalSkills(personalskills);
                    }
                });
                personalskillsDel.push(id);
        }

        const listComputerSkills = (elementen) => {            
            const list = document.getElementById("computerskills");
            if (list) {
                let tempHtmlList = "<ul>";
                if (elementen) {
                    elementen.forEach(skill => {
                        tempHtmlList += `<li id="${skill.Id}">`
                        tempHtmlList += `<div class="list-group list-group-horizontal d-flex gap-5">`
                        tempHtmlList += `<span class="form-field col-6">${skill.Omschrijving}</span>`;
                        tempHtmlList += `<span class="form-field col-6">`
                        
                        tempHtmlList += `</span>`
                        tempHtmlList += "</div>"
                        tempHtmlList += "</li>"
                    });
                    tempHtmlList += "</ul>";
                    list.innerHTML = tempHtmlList;                    
                }
            }
        }
        const onNewComputerSkill = (e) => {
            if(e){
                const list = document.getElementById("newcomputerskill");
                if(list){
                /// TODO: Moet in de vorm van taal of vereenvoudige DTO (ik nu nu eerder vereenvoudigde omdat ook profiel er nog inzit)
                //talen.push(list.value);
                   computerskills.push( {
                        Id: 0,
                        Profiel: null,
                        Omschrijving: list.value,
                        Niveau: "Beginner",
                        Category:" "
                    });
                    listComputerSkills(computerskills);
                }
            }
        }
    </script>
}


