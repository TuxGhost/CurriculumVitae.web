@page
@model JobApplications
@attribute [Authorize]

<h1>Sollicitaties</h1>
@if(Model.JobApplicationList == null || Model.JobApplicationList.Count == 0)
{
    <p>Geen sollicitaties geregistreerd</p>
}
else
{    
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Functie</th>
                <th scope="col">Datum</th>
                <th scope="col">Beschrijving</th>
                <th scope="col">Acties</th>
            </tr>
        </thead>        
        @foreach(var item in Model.JobApplicationList)
        {
            <tr class="table-row">
                @if(Model.IdChange != item.Id)
                {
                    <td>@item.Function</td>
                    <td>@item.ApplicationDate</td>
                    <td>@item.Description</td>
                    <td>
                        <form method="post"> 
                            <button type="submit" asp-page-handler="Edit" asp-route-id="@item.Id" class="btn btn-primary">Bewerken</button>
                            <button type="submit" asp-page-handler="Delete" asp-route-id="@item.Id" class="btn btn-danger">Verwijderen</button>
                        </form>
                    </td>
                }
                else
                {
                    <form method="post" asp-page-handler="Update">
                        <td><input type="text" name="Function" value="@item.Function" required /></td>
                        <td><input type="date" name="ApplicationDate" value="@item.ApplicationDate" required /></td>
                        <td><input type="text" name="Description" value="@item.Description" required /></td>
                        <td>                        
                                <input type="hidden" name="Id" value="@item.Id" />
                                <button type="submit" asp-page-handler="Update" class="btn btn-primary">Opslaan</button>                        
                        </td>
                    </form>
                }
            </tr>
        }
    </table>         
}
@if(!Model.IsAddingMode){
        <form method="post" asp-page-handler="Addrequest">
                <button type="submit" class="btn btn-primary">Nieuwe sollicitatie toevoegen</button>    
            </form>
    } else {            
            <form method="post"  asp-page-handler="Add">
                <input type="text" name="Function" placeholder="Functie" required />
                <input type="date" name="ApplicationDate" required />
                <textarea name="Description" placeholder="Beschrijving"></textarea>
                <button type="submit">Toevoegen</button>
            </form>            
        }       

